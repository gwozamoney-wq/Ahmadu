# ---------------------------------------------------------------------------
# Building and Great Design — environment configuration
# Copy to .env.local and fill in only what you need.
# ---------------------------------------------------------------------------

# Optional: a map embed URL for the exact, verified office pin.
# Easiest way: Google Maps → search the exact address → Share → Embed a map
# → copy the src="..." value from the iframe and paste it below.
# Until this is set, the contact page shows the written address plus a
# "search on Google Maps" link and labels the pin as approximate.
NEXT_PUBLIC_MAP_EMBED_URL=

# Optional but strongly recommended in production: where enquiries are sent.
# Works with Formspree, Make, Zapier, n8n, Google Apps Script, or a custom API.
ENQUIRY_WEBHOOK_URL=
# Optional bearer token added to the webhook request
ENQUIRY_WEBHOOK_TOKEN=

# Protects GET /api/enquiries (read saved enquiries as JSON)
ENQUIRY_ADMIN_TOKEN=

# Salt used when hashing visitor IPs for rate limiting (any random string)
ENQUIRY_SALT=change-me-to-a-random-string
